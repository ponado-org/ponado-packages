{
	"name": "ponado-packages",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter './packages/*' build",
		"dev": "pnpm -r --parallel --filter './packages/*' dev",
		"test": "pnpm -r --filter './packages/*' --if-present test",
		"typecheck": "pnpm -r --filter './packages/*' --if-present typecheck",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"clean": "pnpm -r --filter './packages/*' --if-present clean && rm -rf node_modules",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify && pnpm lint:pkg",
		"verify": "node scripts/verify-dist.mjs",
		"lint:pkg": "pnpm -r --filter './packages/*' exec publint --pack false",
		"check:types": "pnpm -r --filter './packages/*' exec attw --pack . --profile esm-only",
		"changeset": "changeset",
		"version": "changeset version && pnpm install --lockfile-only",
		"release": "pnpm check && changeset publish"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/cli": "^3.0.3",
		"oxfmt": "0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"publint": "^0.3.25",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=22.11.0",
		"pnpm": ">=12.0.0"
	},
	"packageManager": "pnpm@12.18.0"
}
