{
	"name": "@ponado/utils-monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter './packages/*' build",
		"build:all": "pnpm build",
		"dev": "pnpm --filter './packages/*' dev",
		"test": "pnpm --filter './packages/*' test",
		"typecheck": "pnpm --filter './packages/*' typecheck",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"clean": "pnpm --filter './packages/*' clean && rm -rf node_modules",
		"release:patch": "pnpm build && pnpm --filter './packages/*' --sequential release:patch"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.3.0",
		"prettier": "^3.8.3",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2"
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=8.0.0"
	},
	"packageManager": "pnpm@9.0.0"
}
