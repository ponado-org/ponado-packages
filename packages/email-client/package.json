{
	"name": "@ponado/email-client",
	"type": "module",
	"version": "0.0.5",
	"description": "Amazon SES email client (nodemailer transport, dry-run, injected logger)",
	"author": "Adomas Poniškaitis <adomas@ponado.lt>",
	"license": "MIT",
	"homepage": "https://github.com/author/library#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/author/library.git"
	},
	"bugs": {
		"url": "https://github.com/author/library/issues"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"release:patch": "bumpp --release patch --yes --commit=false --tag=false && pnpm publish --no-git-checks",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@aws-sdk/client-sesv2": "^3.1146.0",
		"nodemailer": "^10.0.15"
	},
	"devDependencies": {
		"@types/node": "^20.19.40",
		"bumpp": "^11.1.0",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"vitest": "^1.6.1"
	},
	"publishConfig": {
		"registry": "https://git.ponado.lt/api/packages/ponado/npm/"
	}
}
