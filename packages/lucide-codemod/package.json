{
	"name": "@ponado/lucide-codemod",
	"type": "module",
	"version": "0.0.1",
	"description": "Codemod: per-icon @lucide/svelte imports named with the XIcon convention",
	"author": "Adomas Poniškaitis <adomas@ponado.lt>",
	"license": "MIT",
	"homepage": "https://github.com/author/library#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/author/library.git"
	},
	"bugs": {
		"url": "https://github.com/author/library/issues"
	},
	"bin": {
		"lucide-codemod": "./dist/cli.mjs"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"release:patch": "bumpp --release patch --yes --commit=false --tag=false && pnpm publish --no-git-checks",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"@types/node": "^20.19.40",
		"bumpp": "^11.1.0",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"vitest": "^1.6.1"
	},
	"publishConfig": {
		"registry": "https://git.ponado.lt/api/packages/ponado/npm/"
	}
}
