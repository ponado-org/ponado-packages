{
	"name": "@ponado/stockx-client",
	"type": "module",
	"version": "0.0.8",
	"description": "Wrapper for stockx operations",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"clean": "rm -rf dist",
		"release:patch": "bumpp --release patch --yes --commit=false --tag=false && pnpm publish --no-git-checks",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"bumpp": "^11.1.0",
		"pino": "^10.3.1",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"registry": "https://git.ponado.lt/api/packages/ponado/npm/"
	}
}
