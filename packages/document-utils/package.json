{
	"name": "@ponado/document-utils",
	"type": "module",
	"version": "0.0.9",
	"description": "Shared utilities for working with documents in node environment",
	"author": "Adomas Poniškaitis <adomas@ponado.lt>",
	"license": "MIT",
	"homepage": "https://github.com/author/library#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/author/library.git"
	},
	"bugs": {
		"url": "https://github.com/author/library/issues"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./server": "./dist/server/index.mjs",
		"./shared": "./dist/shared/index.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"release:patch": "bumpp --release patch --yes --commit=false --tag=false && pnpm publish --no-git-checks",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"@types/node": "^20.19.40",
		"bumpp": "^11.1.0",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"vitest": "^1.6.1"
	},
	"dependencies": {
		"@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
		"docx-merger": "^1.2.2",
		"docxtemplater": "^3.68.7",
		"pdf-lib": "^1.17.1",
		"pizzip": "^3.2.0",
		"xlsx-write-stream": "^1.0.3"
	},
	"inlinedDependencies": {
		"p-limit": "2.3.0",
		"p-try": "2.2.0"
	},
	"publishConfig": {
		"registry": "https://git.ponado.lt/api/packages/ponado/npm/"
	}
}
