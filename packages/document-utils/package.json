{
  "name": "@ponado/document-utils",
  "type": "module",
  "version": "0.0.4",
  "description": "Shared utilities for working with documents in node environment",
  "author": "Adomas Poniškaitis <adomas@ponado.lt>",
  "license": "MIT",
  "homepage": "https://github.com/author/library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp --execute='pnpm publish --no-git-checks'",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "docx-merger": "^1.2.2",
    "docxtemplater": "^3.68.6",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "xlsx-write-stream": "^1.0.3"
  }
}
