{
	"name": "@ponado/google-calendar-client",
	"type": "module",
	"version": "0.0.6",
	"description": "Google calendar wrapper",
	"author": "Adomas Poniškaitis <adomas@ponado.lt>",
	"license": "MIT",
	"homepage": "https://github.com/author/library#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/author/library.git"
	},
	"bugs": {
		"url": "https://github.com/author/library/issues"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"release:patch": "bumpp --release patch --yes --commit=false --tag=false && pnpm publish --no-git-checks",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"@types/node": "^20.19.41",
		"bumpp": "^11.1.0",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"vitest": "^1.6.1"
	},
	"dependencies": {
		"@googleapis/calendar": "^14.2.0",
		"google-auth-library": "^10.6.2"
	}
}
