{
	"name": "@ponado/s3",
	"type": "module",
	"version": "0.0.9",
	"description": "Common aws s3 package wrapper method, for easier management",
	"author": "Adomas Poniškaitis <adomas@ponado.lt>",
	"license": "MIT",
	"homepage": "https://github.com/author/library#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/author/library.git"
	},
	"bugs": {
		"url": "https://github.com/author/library/issues"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"release:patch": "bumpp --release patch --yes --no-commit --no-tag && pnpm publish --no-git-checks",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"@types/node": "^20.19.40",
		"bumpp": "^11.1.0",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"vitest": "^1.6.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1045.0",
		"@aws-sdk/s3-request-presigner": "^3.1045.0",
		"file-type": "^22.0.1"
	},
	"publishConfig": {
		"registry": "https://git.ponado.lt/api/packages/ponado/npm/"
	}
}
