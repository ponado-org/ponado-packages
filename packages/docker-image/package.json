{
	"name": "@ponado-org/docker-image",
	"type": "module",
	"version": "0.5.0",
	"description": "Build, tag and mirror Docker images with one shared policy",
	"author": "Adomas Poniškaitis <adomas@ponado.lt>",
	"license": "MIT",
	"homepage": "https://github.com/ponado-org/ponado-packages/tree/main/packages/docker-image",
	"repository": {
		"type": "git",
		"url": "https://github.com/ponado-org/ponado-packages.git",
		"directory": "packages/docker-image"
	},
	"bin": {
		"ponado-docker-image": "./dist/cli.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@types/node": "^20.19.41",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"vitest": "^1.6.1"
	},
	"bugs": {
		"url": "https://github.com/ponado-org/ponado-packages/issues"
	}
}
